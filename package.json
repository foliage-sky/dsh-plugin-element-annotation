{
  "name": "dsh-plugin-element-annotation",
  "version": "0.1.0",
  "description": "Point at page elements or drag a box in the DSH sidebar document preview, then send all change requests to the AI in one message.",
  "type": "module",
  "license": "MIT",
  "author": "foliage-sky",
  "homepage": "https://github.com/foliage-sky/dsh-plugin-element-annotation#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foliage-sky/dsh-plugin-element-annotation.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "annotation",
    "document-preview",
    "review"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
